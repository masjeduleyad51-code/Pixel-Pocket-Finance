-- R3: Sales &amp; Income Summary
CREATE VIEW IF NOT EXISTS v_sales_summary AS
SELECT
    strftime('%Y-%m', o.order_date)              AS month,
    COUNT(DISTINCT o.id)                          AS total_orders,
    SUM(CASE WHEN o.status = 'COMPLETED' THEN o.total_amount ELSE 0 END) AS total_revenue,
    SUM(CASE WHEN o.status = 'REFUNDED'  THEN r.amount       ELSE 0 END) AS total_refunds,
    SUM(CASE WHEN o.status = 'PENDING'   THEN o.total_amount ELSE 0 END) AS pending_payments,
    SUM(CASE WHEN o.status = 'COMPLETED' THEN o.total_amount ELSE 0 END)
      - COALESCE(SUM(CASE WHEN o.status = 'REFUNDED' THEN r.amount ELSE 0 END),0) AS net_income
FROM orders o
LEFT JOIN refunds r ON r.order_id = o.id
GROUP BY strftime('%Y-%m', o.order_date);

-- R4: Product Profit View
CREATE VIEW IF NOT EXISTS v_product_profit AS
SELECT
    p.id,
    p.name                                   AS product_name,
    c.name                                   AS category,
    p.cost_price,
    p.sale_price,
    (p.sale_price - p.cost_price)            AS profit_per_unit,
    ROUND((p.sale_price - p.cost_price) / p.sale_price * 100, 2) AS margin_pct,
    COALESCE(SUM(oi.quantity),0)             AS units_sold,
    COALESCE(SUM(oi.quantity * (oi.unit_price - oi.unit_cost)),0) AS total_profit
FROM products p
JOIN categories c ON c.id = p.category_id
LEFT JOIN order_items oi ON oi.product_id = p.id
LEFT JOIN orders o ON o.id = oi.order_id AND o.status = 'COMPLETED'
GROUP BY p.id;

-- Dashboard KPI quick view
CREATE VIEW IF NOT EXISTS v_dashboard_kpis AS
SELECT
    (SELECT COALESCE(SUM(total_amount),0) FROM orders WHERE status='COMPLETED') AS total_revenue,
    (SELECT COALESCE(SUM(amount),0)       FROM refunds)                          AS total_refunds,
    (SELECT COALESCE(SUM(total_amount),0) FROM orders WHERE status='PENDING')    AS pending_payments,
    (SELECT COUNT(*) FROM orders WHERE status='COMPLETED')                        AS completed_orders,
    (SELECT COUNT(*) FROM orders WHERE status='REFUNDED')                         AS refunded_orders,
    (SELECT COUNT(*) FROM customers)                                               AS total_customers;</sql><current_tab id="0"/></tab_sql></sqlb_project>
