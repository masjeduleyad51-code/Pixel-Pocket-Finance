    ('Smart Watch',          1, 80.00, 199.99,   50);


CREATE TABLE IF NOT EXISTS orders (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    customer_id    INTEGER NOT NULL REFERENCES customers(id),
    order_date     TEXT    NOT NULL DEFAULT (datetime('now')),
    status         TEXT    NOT NULL CHECK(status IN ('COMPLETED','PENDING','REFUNDED','CANCELLED')),
    total_amount   REAL    NOT NULL DEFAULT 0,
    notes          TEXT
);

CREATE TABLE IF NOT EXISTS order_items (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id   INTEGER NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    product_id INTEGER NOT NULL REFERENCES products(id),
    quantity   INTEGER NOT NULL CHECK(quantity &gt; 0),
    unit_price REAL    NOT NULL CHECK(unit_price &gt;= 0),
    unit_cost  REAL    NOT NULL CHECK(unit_cost  &gt;= 0)
);

CREATE TABLE IF NOT EXISTS refunds (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id     INTEGER NOT NULL REFERENCES orders(id),
    refund_date  TEXT    NOT NULL DEFAULT (datetime('now')),
    amount       REAL    NOT NULL CHECK(amount &gt;= 0),
    reason       TEXT,
    processed_by INTEGER REFERENCES users(id)
);

CREATE TABLE IF NOT EXISTS anomaly_log (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    detected_at  TEXT    NOT NULL DEFAULT (datetime('now')),
    anomaly_type TEXT    NOT NULL, -- e.g. 'HIGH_REFUND_RATE', 'LOW_SALES'
    description  TEXT    NOT NULL,
    severity     TEXT    NOT NULL CHECK(severity IN ('LOW','MEDIUM','HIGH')),
    is_resolved  INTEGER NOT NULL DEFAULT 0
);

