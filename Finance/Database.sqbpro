CREATE TABLE IF NOT EXISTS products (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT    NOT NULL,
    category_id INTEGER NOT NULL REFERENCES categories(id),
    cost_price  REAL    NOT NULL CHECK(cost_price &gt;= 0),
    sale_price  REAL    NOT NULL CHECK(sale_price &gt;= 0),
    stock       INTEGER NOT NULL DEFAULT 0,
    created_at  TEXT    NOT NULL DEFAULT (datetime('now'))
);

INSERT OR IGNORE INTO products (name, category_id, cost_price, sale_price, stock) VALUES
    ('Wireless Headphones',  1, 45.00,  89.99,  120),
    ('Bluetooth Speaker',    1, 30.00,  59.99,   80),
